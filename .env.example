# ============================================================================
# Ethiogen Job Seeker Hub - environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

# --- Django -----------------------------------------------------------------
# DEBUG is OFF unless this is 1/true/yes/on.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated. Use your real hostnames in production.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---------------------------------------------------------------
# sqlite (default) | postgresql
DB_ENGINE=sqlite

# Only used when DB_ENGINE=postgresql
DB_NAME=ethiogen
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Alternate token name accepted by the project.
# ETHIOGEN_BOT_TOKEN=
# Channel/group the bot publishes to. The bot must be an admin there.
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_USERNAME=ethiogenjob
# Legacy/default chat id used by some settings.
TELEGRAM_CHAT_ID=@your_channel_username
# Alternative names accepted by the project:
# ETHIOGEN_UPDATE_GROUP_ID is what populates settings.TELEGRAM_CHANNEL_ID.
ETHIOGEN_UPDATE_GROUP_ID=
# ETHIOGEN_CHANNEL_USERNAME is what populates settings.TELEGRAM_CHANNEL_USERNAME.
ETHIOGEN_CHANNEL_USERNAME=ethiogenjob
ETHIOGEN_BOT_USERNAME=ethiogenjob_bot
# Comma-separated Telegram user IDs allowed to run /scrape, /tenders, /approve,
# /reject and /stats.
ETHIOGEN_ADMIN_IDS=
# Optional discussion group for /joingroup.
TELEGRAM_GROUP_ID=

# --- Website / mini app -----------------------------------------------------
BILLING_SITE_URL=https://ethiogen.com
# Cross-origin mini app / API hosts (comma-separated). Empty = deny all.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Subscription defaults --------------------------------------------------
BILLING_CURRENCY=ETB
BILLING_SUBSCRIPTION_PRICE=500.00
BILLING_SUBSCRIPTION_DAYS=30

# --- Manual payment details -------------------------------------------------
BILLING_BANK_NAME=Commercial Bank of Ethiopia
BILLING_BANK_ACCOUNT_NAME=Ethiogen PLC
BILLING_BANK_ACCOUNT_NUMBER=1000123456789012
BILLING_TELEBIRR_PHONE=+251911000000
BILLING_TELEBIRR_NAME=Ethiogen PLC

# --- Chapa ------------------------------------------------------------------
CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
CHAPA_API_BASE=https://api.chapa.co/v1
# 1 = activate immediately on a successful Chapa webhook; 0 = manual review.
CHAPA_AUTO_APPROVE=1

# --- Telebirr gateway (optional) -------------------------------------------
TELEBIRR_API_BASE=
TELEBIRR_API_KEY=
TELEBIRR_MERCHANT_ID=

# --- Facebook page (optional) ----------------------------------------------
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_NAME=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v21.0

# --- Scrapers (optional) ----------------------------------------------------
ETHIOGEN_SCRAPER_URL=
ETHIOGEN_SELECTOR=
ETHIOGEN_BACKEND_URL=
ETHIOGEN_API_KEY=
MERKATO_EMAIL=
MERKATO_PASSWORD=

# --- Optional transcription -------------------------------------------------
WHISPER_MODEL=base
