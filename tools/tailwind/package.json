{
  "name": "ethiogen-tailwind-build",
  "private": true,
  "version": "1.0.0",
  "description": "Builds a static Tailwind stylesheet so the UI does not depend on the runtime-JIT CDN.",
  "scripts": {
    "build": "tailwindcss -i ./input.css -o ../../static/css/tailwind.css --minify",
    "watch": "tailwindcss -i ./input.css -o ../../static/css/tailwind.css --watch",
    "build:verbose": "tailwindcss -i ./input.css -o ../../static/css/tailwind.css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}